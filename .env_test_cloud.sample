# Copy to .env_test_cloud for the local GeoNode + GeoServer Cloud test stack.
# Values in this file are applied only to test commands; runtime deployment files remain separate.
SITEURL=http://localhost/
DATABASE_URL=postgis://postgres:postgres@db:5432/geonode
GEODATABASE_URL=postgis://postgres:postgres@db:5432/geonode_data
GEONODE_GEODATABASE=test_geonode_data

NOXT_GEOSERVER_CLOUD_ENABLED=True
NOXT_GEOSERVER_ACL_ENABLED=True
NOXT_GEOSERVER_INTEGRATION_TESTS=True
NOXT_GEOSERVER_ACL_URL=http://acl:8080/acl/
NOXT_GEOSERVER_ACL_HEALTH_URL=http://acl:8081/actuator/health
NOXT_GEOSERVER_CLOUD_WMS_ENDPOINT=geonode/ows
NOXT_GEOSERVER_CLOUD_REST_URL=http://restconfig:8080/rest
NOXT_GEOSERVER_CLOUD_WFS_URL=http://geoserver:9090/geoserver/cloud/wfs

GEOSERVER_LB_HOST_IP=geoserver
GEOSERVER_LB_PORT=9090
GEOSERVER_LOCATION=http://geoserver:9090/geoserver/cloud/
GEOSERVER_PUBLIC_LOCATION=http://localhost/geoserver/
GEOSERVER_WEB_UI_LOCATION=http://localhost/geoserver/cloud/
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver

SOCIALACCOUNT_OIDC_PROVIDER_ENABLED=True
SOCIALACCOUNT_PROVIDER=google
NOXT_GEONODE_OIDC_PRIVATE_KEY_FILE=/run/secrets/geonode-oidc-private-key

# Remote Firefox is a test dependency; the token files contain opaque test-only credentials.
NOXT_SELENIUM_REMOTE_URL=http://selenium:4444/wd/hub
NOXT_GEOSERVER_CLOUD_TEST_AUTHORIZED_TOKEN_FILE=/tmp/noxt_cloud_bearer.token
NOXT_GEOSERVER_CLOUD_TEST_UNAUTHORIZED_TOKEN_FILE=/tmp/noxt_cloud_bearer_unauthorized.token
NOXT_MANUAL_TEST_PASSWORD=<local-manual-login-password>
