# Copy this to .env.geoserver-cloud and replace the path and secret placeholders.
# Keep real credentials and signing keys out of version control.
COMPOSE_PROJECT_NAME=geonode-cloud-oidc
# GeoServer Cloud defaults from the upstream compose/.env file.
GS_USER=1000:1000
GEOSERVER_DEFAULT_PROFILES=default,acl
GATEWAY_DEFAULT_PROFILES=default
GEOSERVER_BASE_PATH=/geoserver
JAVA_OPTS_DEFAULT=-Xlog:aot -XshowSettings:system
COMPOSE_ENV_FILES=.env_dev
HTTP_PORT=80
HTTPS_PORT=8445
NOXT_LETSENCRYPT_MODE=disabled

# Canonical public origin. Keep the trailing slash; public GeoServer URLs and
# the OIDC callback are derived from this value.
SITEURL=http://localhost

DATABASE_URL=postgis://<user>:<password>@db:5432/geonode
# Cloud Compose builds GEODATABASE_URL from the separate credentials below.
NOXT_GEONODE_REPO_PATH=/path/to/geonoxt
NOXT_GEOSERVER_CLOUD_REPO_PATH=/path/to/geoserver-cloud
NOXT_GEONODE_OIDC_PRIVATE_KEY_SOURCE=/path/outside/the/repository/geonode-oidc-private.pem
NOXT_GEONODE_STATICS_VOLUME=geonode-cloud-oidc-clean-statics
NOXT_GEONODE_DATA_VOLUME=geonode-cloud-oidc-clean-data
NOXT_GEONODE_CLOUD_IMAGE=geonode/geonode:cloud-oidc-local-26.04
NOXT_GEOSERVER_CLOUD_REPOSITORY=ghcr.io/veogeo
NOXT_GEOSERVER_CLOUD_TAG=latest
NOXT_GEOSERVER_CLOUD_GATEWAY_IMAGE=ghcr.io/veogeo/geoserver-cloud-gateway:latest
# Bearer JWT validation is performed by each GeoServer service.
NOXT_GEOSERVER_CLOUD_BEARER_AUTH_ENABLED=true
# Interactive OIDC login in the GeoServer WebUI is independently optional.
NOXT_GEOSERVER_CLOUD_OIDC_WEB_LOGIN_ENABLED=true
NOXT_GEOSERVER_CLOUD_ISSUER_URI=http://localhost/o/
# Discovery is derived from the issuer (with an internal GeoNode URL when local).
# Set this explicitly only when the provider uses a non-standard discovery path.
NOXT_GEOSERVER_CLOUD_DISCOVERY_URI=
# GeoNode's public issuer uses localhost; services need this internal JWKS URL.
# For an external IdP, set its reachable JWKS URL or leave blank for discovery.
NOXT_GEOSERVER_CLOUD_JWK_SET_URI=http://django:8000/o/.well-known/jwks.json
NOXT_GEOSERVER_CLOUD_AUDIENCE=geoserver-cloud
NOXT_GEOSERVER_CLOUD_USERNAME_CLAIM=preferred_username
NOXT_GEOSERVER_CLOUD_USER_FIELD=username
NOXT_GEOSERVER_CLOUD_ROLES_CLAIM=groups
NOXT_GEOSERVER_CLOUD_ROLE_PREFIX=
NOXT_GEOSERVER_CLOUD_ROLE_MAPPINGS_ADMIN=ADMIN
NOXT_GEOSERVER_CLOUD_ROLE_MAPPINGS_AUTHENTICATED=ROLE_AUTHENTICATED
NOXT_GEOSERVER_CLOUD_ROLE_MAPPINGS_PRIVATE_READERS=ROLE_PRIVATE_READERS
NOXT_MAPSTORE_OIDC_CLIENT_ID=noxt-mapstore-client
NOXT_MAPSTORE_OIDC_DISCOVERY_URI=http://localhost/o/.well-known/openid-configuration/
NOXT_MAPSTORE_OIDC_REDIRECT_URI=http://localhost/catalogue/
NOXT_MAPSTORE_OIDC_SCOPES="openid groups offline_access"
NOXT_MAPSTORE_OIDC_RESOURCE=
NOXT_GEOSERVER_CLOUD_OIDC_CLIENT_ID=geonode-cloud-local
NOXT_GEOSERVER_CLOUD_OIDC_CLIENT_SECRET=<confidential-client-secret>
NOXT_GEOSERVER_CLOUD_OIDC_ALLOW_ADMIN_LOGIN=true
# Optional derived WebUI image, based on the GHCR latest image, for configurable OIDC admin login.
NOXT_GEOSERVER_CLOUD_WEBUI_PATCH_IMAGE=geoservercloud/geoserver-cloud-webui:ghcr-latest-oidc-admin-fix
NOXT_GEOSERVER_ADMIN_USER=admin
NOXT_GEOSERVER_ADMIN_PASSWORD=<geoserver-rest-admin-password>
NOXT_GEOSERVER_ACL_USER=admin
NOXT_GEOSERVER_ACL_PASSWORD=<different-acl-admin-password>
NOXT_GEOSERVER_CLOUD_DATA_VOLUME=geonode-cloud-oidc-pgconfig-geoserver-data
NOXT_GEOSERVER_CLOUD_CACHE_VOLUME=geonode-cloud-oidc-pgconfig-geowebcache-data
NOXT_GEOSERVER_CLOUD_DB_VOLUME=geonode-cloud-oidc-pgconfig-db
NOXT_GEONODE_DB_VOLUME=geonode-cloud-oidc-postgis-db
NOXT_GEOSERVER_CLOUD_PG_DATABASE=geoserver
NOXT_GEOSERVER_CLOUD_PG_USER=geoserver
NOXT_GEOSERVER_CLOUD_PG_PASSWORD=<generate-a-unique-secret>
NOXT_GEONODE_GEODATABASE_USER=geonode_geodata
NOXT_GEONODE_GEODATABASE_PASSWORD=<generate-a-unique-secret>
