-
-    def set_timeout(self, timeout: int):
-        self.timeout = timeout
-
-    def invalidate_cache(self):
-        r = requests.put(f"{self.baseurl}ruleCache/invalidate", auth=HTTPBasicAuth(self.username, self.pw))
