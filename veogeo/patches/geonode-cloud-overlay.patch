@@ -79,6 +79,28 @@ RESOLVER=127.0.0.11
 # #################
 GEOSERVER_LB_HOST_IP=geoserver
 GEOSERVER_LB_PORT=8080
+# Set to True only when using the separate GeoServer Cloud stack.
+GEOSERVER_CLOUD_ENABLED=False
+# Empty defaults to geofence for GeoServer and ACL for GeoServer Cloud.
+GEOSERVER_SECURITY_BACKEND=
+# Empty enables the selected security backend unless explicitly disabled.
+GEOSERVER_ACL_ENABLED=
+GEOSERVER_ACL_URL=http://acl:8080/acl/
+GEOSERVER_ACL_HEALTH_URL=http://acl:8081/actuator/health
+GEOSERVER_ACL_USER=admin
+GEOSERVER_ACL_PASSWORD={set-a-distinct-secret}
+# Required in Cloud mode; mount a private key as a Docker secret and set this file path.
+OIDC_RSA_PRIVATE_KEY_FILE=/run/secrets/geonode-oidc-private-key
+GEONODE_OIDC_PRIVATE_KEY_SOURCE=/absolute/path/to/geonode-oidc-private-key.pem
+GEOSERVER_CLOUD_OIDC_CLIENT_ID=
+GEOSERVER_CLOUD_OIDC_CLIENT_SECRET=
+# Exact OAuth callback configured in the GeoServer Cloud WebUI provider; can contain multiple lines.
+GEOSERVER_CLOUD_OIDC_REDIRECT_URIS=
+# Required by GeoServer Cloud when opaque GeoNode OAuth access tokens are introspected.
+GEOSERVER_CLOUD_INTROSPECTION_API_KEY=
+GEOSERVER_CLOUD_NETWORK=gsc-oidc-test_default
+# Public gateway origin/base path used by GeoServer WebUI OIDC callbacks.
+GEOSERVER_CLOUD_PUBLIC_BASE_URL=http://localhost:19090/geoserver
 GEOSERVER_WEB_UI_LOCATION={siteurl}/geoserver/
 GEOSERVER_PUBLIC_LOCATION={siteurl}/geoserver/
 GEOSERVER_LOCATION=http://${GEOSERVER_LB_HOST_IP}:${GEOSERVER_LB_PORT}/geoserver/
